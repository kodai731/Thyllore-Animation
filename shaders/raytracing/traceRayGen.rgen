#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require

#define TRACE_STAGE_RAYGEN
#include "include/trace_payload.glsl"
#include "include/trace_push.glsl"

layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 1, rgba16f) uniform image2D outImage;
layout(location = 0) rayPayloadEXT TracePayload payload;

void main() {
    vec2 uv = (vec2(gl_LaunchIDEXT.xy) + 0.5) / vec2(gl_LaunchSizeEXT.xy);
    vec2 ndc = uv * 2.0 - 1.0;
    vec4 world = trace.invViewProj * vec4(ndc, 1.0, 1.0);
    vec3 dir = normalize(world.xyz / world.w - trace.cameraPos.xyz);

    payload.depth = 0;
    traceRayEXT(tlas, gl_RayFlagsOpaqueEXT, 0xff, 0, 0, 0, trace.cameraPos.xyz, 1e-3, dir, 1e30, 0);
    imageStore(outImage, ivec2(gl_LaunchIDEXT.xy), payload.color);
}
